# clang-format's Google preset with the stricter choices from the Google C++
# Style Guide, plus some departures taken from common Allman practice: Allman
# braces, 4-space indents, access specifiers and case labels flush with their
# class or switch, case blocks indented under their label, no one-line
# functions, one space before end-of-line comments (lined up when they end
# consecutive lines), and a 120-column limit. Every namespace gets a closing
# comment, however short it is.
BasedOnStyle: Google
IndentWidth: 4
AccessModifierOffset: -4
ColumnLimit: 120
IndentCaseLabels: false
IndentCaseBlocks: true
SpacesBeforeTrailingComments: 1
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
ShortNamespaceLines: 0
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterExternBlock: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
AllowShortFunctionsOnASingleLine: None
AllowShortEnumsOnASingleLine: false
AllowShortLambdasOnASingleLine: Inline
DerivePointerAlignment: false
PointerAlignment: Left
InsertBraces: true
EmptyLineBeforeAccessModifier: Always
# Includes go in the guide's groups: the related header, C system headers, C++
# standard library headers, other libraries' headers, then the project's
# headers. Other libraries are xsflib, ntdlib and seqlib in quotes, and the
# third-party libraries in the first two categories in angle brackets (SDK/ is
# the foobar2000 SDK). OS headers, such as <windows.h>, count as C system
# headers. In the code of xsflib, ntdlib or seqlib, remove that library from
# the list.
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<(zlib|zconf|zstd|lzma|bzlib)\.h>$'
    Priority: 3
  - Regex: '^<(FLAC|FLAC\+\+|teakra|SDK)/'
    Priority: 3
  - Regex: '^<ext/.*\.h>'
    Priority: 2
  - Regex: '^<.*\.h>'
    Priority: 1
  - Regex: '^<.*'
    Priority: 2
  - Regex: '^"(xsflib|ntdlib|seqlib)/'
    Priority: 3
  - Regex: '.*'
    Priority: 4
